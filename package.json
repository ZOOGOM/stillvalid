{
  "name": "stillvalid",
  "version": "0.1.0",
  "private": true,
  "description": "Evidence-linked notice checking with Meta Model API",
  "license": "MIT",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build --webpack",
    "vercel-build": "npm run build && npm run verify:hosted",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:live-harness": "node --test tests/live-evaluation.test.mjs",
    "evaluate:live": "node scripts/evaluate-live.mjs",
    "check": "npm run typecheck && npm test && npm run test:live-harness",
    "verify:meta": "node scripts/check-meta.mjs",
    "verify:hosted": "node --import tsx scripts/check-hosted.mjs",
    "test:browser": "node scripts/browser-check.mjs",
    "format": "prettier --write src tests scripts next.config.ts tsconfig.json"
  },
  "dependencies": {
    "@rapideditor/country-coder": "5.6.1",
    "cheerio": "^1.1.2",
    "ipaddr.js": "^2.2.0",
    "lucide-react": "^0.577.0",
    "next": "16.4.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-easy-crop": "^5.5.6",
    "undici": "^7.16.0",
    "unpdf": "1.9.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@types/ioredis-mock": "^8.2.8",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "ioredis-mock": "^8.13.1",
    "playwright-core": "1.64.1",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
