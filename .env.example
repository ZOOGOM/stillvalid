# Copy to ignored .env.local or register server-side secrets with your host.
# Never prefix a secret with NEXT_PUBLIC_. MODEL_API_KEY is an accepted alias.
META_API_KEY=
META_MODEL=muse-spark-1.3-contributor
# Optional per-step overrides; leave unset to use META_MODEL for all three.
# META_EXTRACTION_MODEL=
# META_SEARCH_MODEL=
# META_COMPARISON_MODEL=
# Vercel/serverless: use either complete REST pair as server secrets.
# Vercel Marketplace's KV_REST_API_URL + KV_REST_API_TOKEN are also supported.
# A nonempty UPSTASH pair takes precedence; never mix pairs or use read-only tokens.
# Local development uses SQLite when both pairs are empty.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# Set the exact external HTTPS origin in production.
APP_URL=http://localhost:3000
# Global paid model requests per UTC day. Not a dollar spending cap.
DAILY_MODEL_CALL_LIMIT=300
# Optional: dedicated key (32+ random chars) for the Vercel IP limit. When empty,
# a key is derived from the model credential so the limit stays on.
IP_RATE_LIMIT_SECRET=
# Opt-in hosting-build probe: one real paid text extraction plus a short-lived Redis probe.
# Set to 1 in Production for one reviewed deployment, then reset to 0.
STILLVALID_VERIFY_DEPLOYMENT=0
# Optional absolute SQLite path; default .data/stillvalid.sqlite.
# DATABASE_PATH=/app/data/stillvalid.sqlite
# Institution domains independently verified by the operator, comma-separated.
VERIFIED_SOURCE_HOSTS=
# Reasoning effort per step (minimal, low, medium, high, xhigh, max, or none to
# send nothing). Unset: all three steps use minimal.
META_REASONING_EFFORT_EXTRACTION=
META_REASONING_EFFORT_COMPARISON=
META_REASONING_EFFORT_SEARCH=
# Optional 1..5 cap on built-in search tool calls within one API request.
# Leave unset to avoid restricting amendment/cancellation discovery.
# META_SEARCH_MAX_TOOL_CALLS=
